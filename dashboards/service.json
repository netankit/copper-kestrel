{
  "title": "searchd",
  "uid": "searchd-main",
  "timezone": "utc",
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "CPU usage by pod",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{container=\"searchd\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory working set by pod",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{container=\"searchd\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pod restarts (24h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{container=\"searchd\"}[24h]))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Ready replicas",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "kube_statefulset_status_replicas_ready{statefulset=\"searchd\"}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Disk used on index volume",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "sum by (persistentvolumeclaim) (kubelet_volume_stats_used_bytes{persistentvolumeclaim=~\"index-searchd.*\"})",
          "legendFormat": "{{persistentvolumeclaim}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum(rate(searchd_requests_total[5m]))"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 7
}
